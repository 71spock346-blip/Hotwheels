# ---------------------------------------------------------------- required ---
# Photo identification. Get a key at https://console.anthropic.com -> API Keys,
# then add it in Vercel: Project -> Settings -> Environment Variables.
#
# Without this the app still works: barcode scanning, manual entry, your saved
# collection, search, stats and export. Only photo identification is disabled.
ANTHROPIC_API_KEY=sk-ant-...

# Cost per identification decides whether this can be sold at a sane price, and
# the model is the biggest lever on it. Default claude-opus-5 reads small toy
# numbers off glary cards most reliably. claude-sonnet-5 is cheaper, and
# claude-haiku-4-5 cheaper still — measure accuracy on your own cards before
# switching, because a wrong toy number silently breaks duplicate detection.
IDENTIFY_MODEL=claude-opus-5

# low | medium | high. Lower trades some care for fewer tokens.
IDENTIFY_EFFORT=medium


# ------------------------------------------------- free-tier metering (Play) ---
# Only needed once the app is public. Until a store is configured, metering is
# off and identification is unlimited — which is what you want for private use.
#
# Create a Redis database from the Vercel Marketplace (Storage -> Upstash) and
# it will set these two for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Free identifications per install before any purchase. Default 10.
FREE_SCAN_LIMIT=10


# ------------------------------------------------------ Google Play Billing ---
# Your app's package name, e.g. com.yourname.garage. Also used for the Digital
# Asset Links file that removes the URL bar from the Play Store app.
TWA_PACKAGE_NAME=

# SHA-256 certificate fingerprint from Play Console ->
# Test and release -> Setup -> App signing. Comma-separate if Play lists several.
TWA_SHA256_FINGERPRINT=

# Consumable in-app products from Play Console -> Monetise -> In-app products,
# mapped to the identifications each one grants. Prices are read live from Play,
# so they belong in the Play Console only — never here.
PLAY_CREDIT_PACKS=[{"id":"identifications_250","credits":250},{"id":"identifications_1000","credits":1000}]

# Service account with the "View financial data" permission, used to verify
# purchases server side. From Google Cloud Console -> IAM -> Service Accounts,
# then grant it access in Play Console -> Users and permissions.
# Paste the private key exactly as it appears in the JSON, newlines and all.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
