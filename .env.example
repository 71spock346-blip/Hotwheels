# Required for photo identification (the "point your phone at a card" feature).
# Get a key at https://console.anthropic.com -> API Keys, then add it in Vercel:
#   Project -> Settings -> Environment Variables -> ANTHROPIC_API_KEY
#
# Without this key the app still works fully: barcode scanning, manual entry,
# your saved collection, search, stats and export. Only photo ID is disabled.
ANTHROPIC_API_KEY=sk-ant-...
